{
  "compilerOptions": {
    "strict": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "jsx": "react-jsx",
    "verbatimModuleSyntax": true,
    "declaration": true,
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "vitest.config.ts",
    ".storybook/**/*.ts",
    ".storybook/**/*.tsx",
    "playwright.config.ts",
    "e2e/**/*.ts"
  ]
}
